#pragma once

// The graph combinators: trusted Rego, like the two in rego_combinators.h. CMake
// generates this header from pdo/rego/graph/graph_validator.rego and graph_planner.rego,
// which the reference implementation (pdo.rego.graph) runs too.

static const char REGO_GRAPH_VALIDATOR[] = R"REGO(@REGO_GRAPH_VALIDATOR@)REGO";

static const char REGO_GRAPH_PLANNER[] = R"REGO(@REGO_GRAPH_PLANNER@)REGO";
