{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component_credential.schema.json",
  "title": "Component credential",
  "description": "A credential as a component reads it in input.inputs, and returns it from its output rule. A presented one also has issuer, and its evidence is its own index. key_checks is on the output of a component with a supplied_key input, and only there.",
  "type": "object",
  "properties": {
    "type": {"type": "string", "minLength": 1},
    "issuer": {"type": "string"},
    "subject": {"type": "string", "minLength": 1},
    "claims": {"type": "object"},
    "evidence": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "key_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "key": {"type": "string", "minLength": 1},
          "key_type": {"enum": ["ec", "rsa"]}
        },
        "required": ["index", "key", "key_type"],
        "additionalProperties": false
      }
    }
  },
  "required": ["type", "subject", "claims", "evidence"],
  "additionalProperties": false
}
