{
  "registry": {
    "membership": ["did:example:members"],
    "membership_grant": ["did:example:office"],
    "public_key": ["did:example:keys"]
  },
  "request": {"channel_key": "KEY-1"},
  "policy_data": {
    "member": {"allowedInstitutions": ["Hyperledger", "Intel"]},
    "download": {}
  },
  "credentials": {
    "membership": {"type": "membership", "issuer": "did:example:members", "signer": "did:example:members",
                   "subject": "did:example:applicant", "claims": {"institution": "Hyperledger"}},
    "key": {"type": "public_key", "issuer": "did:example:keys", "signer": "did:example:keys",
            "subject": "did:example:applicant", "claims": {"key": "KEY-1"}},
    "other_key": {"type": "public_key", "issuer": "did:example:keys", "signer": "did:example:keys",
                  "subject": "did:example:applicant", "claims": {"key": "KEY-2"}},
    "grant": {"type": "membership_grant", "issuer": "did:example:office", "signer": "did:example:office",
              "subject": "did:example:applicant", "claims": {}}
  },
  "tests": [
    {
      "name": "allow: an allowed membership and the requested key",
      "present": {"applicant": ["membership", "key"]},
      "change": {},
      "expect": {"decision": true, "subject": "did:example:applicant",
                 "operation": {"name": "do_download", "parameters": {"channel_key": "KEY-1"}},
                 "evidence": ["membership", "key"], "verified": ["membership", "key"]}
    },
    {
      "name": "deny: an institution the owner does not allow",
      "present": {"applicant": ["membership", "key"]},
      "change": {"membership": {"claims": {"institution": "Elsewhere"}}},
      "expect": {"decision": false, "reason": "the root issued no capability"}
    },
    {
      "name": "deny: a key other than the requested one",
      "present": {"applicant": ["membership", "other_key"]},
      "change": {},
      "expect": {"decision": false, "reason": "the root issued no capability"}
    },
    {
      "name": "deny: the key of someone else",
      "present": {"applicant": ["membership", "key"]},
      "change": {"key": {"subject": "did:example:someone-else"}},
      "expect": {"decision": false, "reason": "the root issued no capability"}
    },
    {
      "name": "deny: no key presented",
      "present": {"applicant": ["membership"]},
      "change": {},
      "expect": {"decision": false, "missing": [{"node": "download", "input": "key"}]}
    },
    {
      "name": "deny: a membership from an issuer the contract does not trust",
      "present": {"applicant": ["membership", "key"]},
      "change": {"membership": {"issuer": "did:example:elsewhere", "signer": "did:example:elsewhere"}},
      "expect": {"decision": false, "missing": [{"node": "member", "input": "membership"}]}
    },
    {
      "name": "deny: a membership whose issuer is not its signer",
      "present": {"applicant": ["membership", "key"]},
      "change": {"membership": {"signer": "did:example:keys"}},
      "expect": {"decision": false, "missing": [{"node": "member", "input": "membership"}]}
    },
    {
      "name": "allow: a presented grant stands in for the membership",
      "present": {"applicant": ["grant", "key"]},
      "change": {},
      "expect": {"decision": true, "subject": "did:example:applicant",
                 "operation": {"name": "do_download", "parameters": {"channel_key": "KEY-1"}},
                 "evidence": ["grant", "key"], "verified": ["grant", "key"]}
    },
    {
      "name": "allow: an untrusted grant is passed over for the membership",
      "present": {"applicant": ["grant", "membership", "key"]},
      "change": {"grant": {"issuer": "did:example:elsewhere", "signer": "did:example:elsewhere"}},
      "expect": {"decision": true, "subject": "did:example:applicant",
                 "operation": {"name": "do_download", "parameters": {"channel_key": "KEY-1"}},
                 "evidence": ["membership", "key"], "verified": ["membership", "key"]}
    },
    {
      "name": "allow: two keys, the request names one, both are verified",
      "present": {"applicant": ["membership", "other_key", "key"]},
      "change": {},
      "expect": {"decision": true, "subject": "did:example:applicant",
                 "operation": {"name": "do_download", "parameters": {"channel_key": "KEY-1"}},
                 "evidence": ["membership", "key"], "verified": ["membership", "other_key", "key"]}
    }
  ]
}
